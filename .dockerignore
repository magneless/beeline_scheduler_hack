# Keep the server, datasets and contract fixtures in the backend build context.
**
!backend/
!backend/**
!datasets/
!datasets/original/
!datasets/original/**
!datasets/additional_days/
!datasets/additional_days/**
!docs/
!docs/contracts/
!docs/contracts/examples/
!docs/contracts/examples/**

**/.cache/
**/.git/
**/.agents/
**/.codex/
**/.env
**/.env.*
**/node_modules/
**/*.test
**/coverage.out
**/.DS_Store

# Research adapters remain local; the runtime uses the production VROOM adapter.
backend/cmd/benchsolver/
backend/cmd/solverdecision/
backend/internal/planner/experiment/
backend/internal/planner/optimized/experiment.go
