POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgres://scheduler:change-me-local@localhost:5432/scheduler?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
DEPENDENCY_MODE=integrated
SOLVER_MODE=optimized

# Real OSM geodata; use demo explicitly for offline synthetic fixtures.
GEO_PROVIDER=osm
GEO_PHOTON_URL=https://photon.komoot.io
GEO_OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
GEO_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
GEO_USER_AGENT=beeline-scheduler/1.0 (https://github.com/magneless/beeline_scheduler_hack)
GEO_MIN_INTERVAL_MS=1000
